{
  "name": "nuxt-easy-texts",
  "version": "2.2.0",
  "description": "Easy key-based text extractor and loader for Nuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dulnan/nuxt-easy-texts.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./loader": "./dist/loader.mjs",
    "./drupal": "./dist/drupal.mjs"
  },
  "main": "./dist/module.mjs",
  "bin": {
    "nuxt-easy-texts": "./dist/cli.mjs"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "loader": [
        "./dist/loader.d.mts"
      ],
      "drupal": [
        "./dist/drupal.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build -vvv",
    "dev": "nuxi dev playground --host",
    "dev:drupal": "nuxi dev playground-drupal/nuxt --host",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit && cd ../playground-drupal/nuxt && vue-tsc --noEmit",
    "dev:build": "nuxi build playground",
    "dev:start": "node ./playground/.output/server/index.mjs",
    "dev:prepare": "PLAYGROUND_MODULE_BUILD=true nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground && nuxi prepare playground-drupal/nuxt",
    "lint": "oxlint ./src && eslint ./src",
    "lint:fix": "oxlint ./src --fix && eslint ./src --fix",
    "test": "vitest run",
    "test:drupal": "NUXT_DRUPAL_URL=http://nuxt-easy-texts.ddev.site vitest run test/e2e/drupal.test.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": [
    {
      "name": "Jan Hug",
      "url": "https://www.dulnan.net"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@nuxt/kit": "^4.6.3",
    "acorn": "^8.19.0",
    "astring": "^1.9.0",
    "devalue": "^6.0.3",
    "magic-string": "^1.4.5",
    "micromatch": "^4.0.8",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "unplugin": "^3.7.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.3",
    "@nuxt/test-utils": "^4.3.4",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.90.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.64.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@nuxt/module-builder": {
      "@nuxt/cli": "^4.0.1"
    }
  }
}
